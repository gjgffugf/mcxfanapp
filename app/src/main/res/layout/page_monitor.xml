<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView style="@style/SecTitle" android:text="实时监控" />

        <LinearLayout style="@style/Card">
            <TextView
                android:id="@+id/motdText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MOTD：加载中…"
                android:textColor="#FFEAF6EF"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/pingText"
                style="@style/Body"
                android:layout_marginTop="6dp"
                android:text="延迟：-" />

            <TextView
                android:id="@+id/playerCountText"
                style="@style/Body"
                android:layout_marginTop="4dp"
                android:text="在线：-" />

            <Button
                android:id="@+id/btnRefresh"
                style="@style/Btn"
                android:layout_marginTop="12dp"
                android:text="刷新" />
        </LinearLayout>

        <TextView style="@style/SecTitle" android:text="在线玩家" />
        <LinearLayout style="@style/Card">
            <LinearLayout
                android:id="@+id/playerList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView style="@style/SecTitle" android:text="接口状态" />
        <LinearLayout style="@style/Card">
            <LinearLayout
                android:id="@+id/apiList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <Button
                android:id="@+id/btnRetestApi"
                style="@style/BtnGray"
                android:layout_marginTop="10dp"
                android:text="重新测试" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
