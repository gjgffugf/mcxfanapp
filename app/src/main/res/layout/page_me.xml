<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 未登录 -->
        <LinearLayout
            android:id="@+id/meGuest"
            style="@style/Card"
            android:visibility="visible">
            <TextView
                style="@style/Body"
                android:text="登录后可使用签到、反馈、主题等功能"
                android:textColor="#FFEAF6EF" />
            <Button
                android:id="@+id/meLogin"
                style="@style/Btn"
                android:layout_marginTop="12dp"
                android:text="登录 / 注册" />
        </LinearLayout>

        <!-- 已登录 -->
        <LinearLayout
            android:id="@+id/meUser"
            style="@style/Card"
            android:visibility="gone">
            <TextView
                android:id="@+id/meName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#FFEAF6EF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/meEmail"
                style="@style/Body"
                android:layout_marginTop="4dp"
                android:text="邮箱：无" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mePoints"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="积分 0"
                    android:textColor="#FF5FD68F"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/meSign"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_accent"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="签到"
                    android:textColor="#FF06210F"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/meHint"
                style="@style/Body"
                android:layout_marginTop="6dp"
                android:text="" />

            <TextView
                android:id="@+id/meMsg"
                style="@style/Body"
                android:layout_marginTop="6dp"
                android:text="" />
        </LinearLayout>

        <!-- 主题 -->
        <TextView style="@style/SecTitle" android:text="主题" />
        <LinearLayout
            android:id="@+id/themeList"
            style="@style/Card" />

        <!-- 账号操作 -->
        <TextView style="@style/SecTitle" android:text="账号" />
        <LinearLayout
            android:id="@+id/meActions"
            style="@style/Card" />

    </LinearLayout>
</ScrollView>
