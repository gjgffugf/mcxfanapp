<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 问卷横幅：登录后且有新问卷才显示 -->
        <LinearLayout
            android:id="@+id/surveyBanner"
            style="@style/Card"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/surveyBannerText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="新问卷调查上线，点击前往填写"
                android:textColor="#FFEAF6EF"
                android:textSize="13.5sp" />
            <TextView
                android:id="@+id/surveyClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:text="✕"
                android:textColor="#FFEAF6EF"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- 限定主题横幅图 -->
        <ImageView
            android:id="@+id/themeBanner"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="14dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- 服务器介绍 -->
        <TextView style="@style/SecTitle" android:text="服务器介绍" />
        <LinearLayout style="@style/Card">
            <ImageView
                android:id="@+id/introImg"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:scaleType="centerCrop" />
            <TextView
                android:id="@+id/introText"
                style="@style/Body"
                android:layout_marginTop="12dp"
                android:text="稳定生存服，版本 1.21.11。允许矿透，禁止外挂。" />
        </LinearLayout>

        <!-- 服务器规则 -->
        <TextView style="@style/SecTitle" android:text="服务器规则" />
        <LinearLayout style="@style/Card">
            <TextView
                android:id="@+id/rulesText"
                style="@style/Body"
                android:text="" />
        </LinearLayout>

        <!-- 服务器状态 -->
        <TextView style="@style/SecTitle" android:text="服务器状态" />
        <LinearLayout style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stOnline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="在线状态：检测中…"
                        android:textColor="#FFEAF6EF"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/stAddr"
                        style="@style/Body"
                        android:text="地址：mc.xfan.l.cd" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stPlayers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="在线人数：-"
                        android:textColor="#FFEAF6EF"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/stVersion"
                        style="@style/Body"
                        android:text="版本：-" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/stMotd"
                style="@style/Body"
                android:layout_marginTop="10dp"
                android:text="" />

            <Button
                android:id="@+id/btnRefreshStatus"
                style="@style/Btn"
                android:layout_marginTop="12dp"
                android:text="刷新状态" />
        </LinearLayout>

        <!-- 服主与联系方式 -->
        <TextView style="@style/SecTitle" android:text="服主与联系方式" />
        <LinearLayout style="@style/Card">
            <TextView
                android:id="@+id/contactText"
                style="@style/Body"
                android:text="" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
